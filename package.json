{
  "name": "dsh-plugin-link-resolver",
  "version": "1.0.1",
  "description": "DeepSeek Harness plugin: resolve, download and deliver Bilibili, Douyin, Xiaohongshu, Weibo, X and YouTube links in one step — to Web file cards or an IM conversation — while the model only narrates the result.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Astral-Yang/dsh-plugin-link-resolver.git"
  },
  "homepage": "https://github.com/Astral-Yang/dsh-plugin-link-resolver#readme",
  "bugs": {
    "url": "https://github.com/Astral-Yang/dsh-plugin-link-resolver/issues"
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "docs",
    "lib"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "link-resolver",
    "bilibili",
    "douyin",
    "xiaohongshu",
    "weibo",
    "twitter",
    "youtube"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
